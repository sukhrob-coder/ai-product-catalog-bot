# Bu faylni .env nomi bilan nusxalang va o'z qiymatlaringizni kiriting
# (config.py bu faylni avtomatik o'qiydi)

# @BotFather dan olingan token
BOT_TOKEN=123456789:AAExampleTokenHere

# Kanal username (masalan @star_elect_shop) yoki raqamli ID (masalan -1001234567890)
CHANNEL_ID=@star_elect_shop

# EasyTrade'dan eksport qilingan Excel fayl manzili
EXCEL_PATH=data/mahsulotlar.xlsx

# Rasm fayllar papkasi (agar bo'lsa)
IMAGES_DIR=data/images

# Shu chat ID'lar admin rejimida ishlaydi (vergul bilan ajrating)
ADMIN_CHAT_IDS=123456789

# PostgreSQL
DATABASE_URL=postgresql+psycopg://star_elect:star_elect@postgres:5432/star_elect
POSTGRES_DB=star_elect
POSTGRES_USER=star_elect
POSTGRES_PASSWORD=change-me
INTERNAL_API_KEY=change-this-api-key
API_PORT=8000

# Gemini AI API kaliti (https://aistudio.google.com dan olinadi)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# Do'kon ma'lumotlari (ixtiyoriy)
SHOP_NAME=STAR_ELECT
SHOP_PHONE=+998901234567
SHOP_LOCATION=Toshkent shahri
SHOP_ADMIN_USERNAME=@star_elect_admin
